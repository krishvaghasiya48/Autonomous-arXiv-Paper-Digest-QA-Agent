# -------------------------------------------------------
# arXiv Digest & QA Agent — environment variables
# Copy this file to .env and fill in your keys.
# The agent works without any key by using the ollama
# local path. Groq and Gemini are free-tier.
# -------------------------------------------------------

# Primary LLM — Groq (free tier, very fast)
# Get key at: https://console.groq.com/
GROQ_API_KEY=

# Fallback LLM — Google Gemini (free tier)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Local LLM — Ollama (no key needed, runs offline)
# Install ollama from https://ollama.com/ then: ollama pull llama3.2
# Set OLLAMA_MODEL to your pulled model name.
OLLAMA_MODEL=llama3.2
